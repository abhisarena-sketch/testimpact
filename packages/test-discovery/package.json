{
  "name": "@testimpact/test-discovery",
  "version": "0.1.0",
  "description": "Test file discovery and test-to-source mapping for TestImpact.",
  "license": "MIT",
  "author": "Workfonic Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisarena-sketch/testimpact.git",
    "directory": "packages/test-discovery"
  },
  "keywords": [
    "testing",
    "test-impact",
    "test-selection",
    "static-analysis",
    "typescript"
  ],
  "sideEffects": false,
  "dependencies": {
    "@testimpact/framework-adapters": "0.1.0",
    "picomatch": "^4.0.3"
  },
  "homepage": "https://github.com/abhisarena-sketch/testimpact#readme",
  "bugs": {
    "url": "https://github.com/abhisarena-sketch/testimpact/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
