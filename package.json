{
  "name": "testimpact-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "TestImpact by Workfonic Labs. Change code. Know what to test.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/framework-adapters",
    "packages/dependency-analyzer",
    "packages/test-discovery",
    "packages/core",
    "packages/cli",
    "apps/playground"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:playground": "npm run build --workspace apps/playground",
    "typecheck": "tsc -b tsconfig.build.json --noEmit false && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo .testimpact"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
